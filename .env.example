# ---- Aplikácia ----
APP_NAME="Meet Lab.cafe"
APP_URL=http://localhost:8080
APP_ENV=production            # production | development (zobrazuje chyby)
APP_TIMEZONE=Europe/Bratislava
APP_LANGUAGE=sk               # predvolený jazyk porád (ISO-639-1); prázdne = autodetekcia
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Databáza (MySQL 8 / MariaDB 10.6+) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=meet_labcafe
DB_USER=meet
DB_PASS=secret

# ---- Prepis reči (speech-to-text) ----
# elevenlabs (odporúčané: Scribe v2, diarizácia, slovenčina) | assemblyai
STT_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=scribe_v2
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_BASE_URL=https://api.eu.assemblyai.com   # alebo https://api.assemblyai.com

# ---- Analýza zápisu (AI) ----
# claude (odporúčané) | gemini
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash      # alebo gemini-3.1-pro-preview

# ---- E-mail (zápis po spracovaní porady) ----
MAIL_ENABLED=true
MAIL_AUTO_SEND=true                 # po dokončení analýzy poslať zápis autorovi porady
MAIL_FROM=meet@lab.cafe
MAIL_FROM_NAME="Meet Lab.cafe"
# SMTP; ak SMTP_HOST necháte prázdne, použije sa PHP mail() (sendmail hostingu)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls                     # tls | ssl | none

# ---- Spracovanie na pozadí ----
# cron  = úlohy spracúva iba bin/worker.php alebo URL /cron/run?token=... (odporúčané, každú minútu)
# web   = úlohy sa spustia aj z prehliadača počas čakania (shared hosting bez cronu)
PROCESS_MODE=web
# Token pre cron cez URL: https://domena/cron/run?token=... (náhodný reťazec, prázdne = vypnuté)
CRON_TOKEN=
# Token pre webový inštalátor setup.php?token=... (po inštalácii odstráňte!)
SETUP_TOKEN=
MAX_UPLOAD_MB=300
STORAGE_PATH=storage/audio
